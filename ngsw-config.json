{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 30,
        "maxAge": "30d"
      }
    },
    {
      "name": "attendance-offline",
      "urls": [
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/batches",
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/students?**",
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/attendance/**",
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/dashboard/teacher",
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/holidays/on?**",
        "https://classkendra-api-aad5hxgzf5dtc8fe.centralindia-01.azurewebsites.net/api/v1/holidays/on"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 300,
        "maxAge": "7d"
      }
    }
  ]
}
